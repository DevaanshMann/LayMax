# Copy to .env and paste your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# LAYMAX_MOCK=1          # replay a sample plan with no API calls (UI work / demo backup)
# LAYMAX_EFFORT=medium   # low | medium | high  (higher = slower, more careful)
# LAYMAX_FALLBACKS=1     # server-side fallback model if Claude declines a request
